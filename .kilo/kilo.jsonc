{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "meshtastic": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/meshtastic/meshtastic-mcp",
        "meshtastic-mcp",
      ],
      "environment": {
        "MESHTASTIC_FIRMWARE_ROOT": ".",
      },
    },
  },
  "skills": {
    "paths": [
      "~/.agents/skills",
      "~/.config/kilo/skills",
      "~/.kilo/skills",
      ".agents/skills",
      ".kilo/skills",
    ],
  },
}
